# Copy this to .env and fill in your values

# PostgreSQL connection string (Render provides this automatically)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# JWT session signing secret (use a long random string in production)
SESSION_SECRET="change-me-to-a-long-random-secret"

# App URL (used for redirects, etc.)
NEXT_PUBLIC_APP_URL="https://your-app.onrender.com"

# S3 / file uploads (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=curavia-uploads
# AWS_REGION=us-east-1
# S3_ENDPOINT=
